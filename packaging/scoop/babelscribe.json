{
    "version": "0.4.0",
    "description": "Transcribe audio and video into subtitles on any GPU (Vulkan/CUDA/Metal) or CPU, in 99 languages",
    "homepage": "https://github.com/phonology024/babelscribe",
    "license": "MIT",
    "notes": [
        "The first run downloads whisper-cli for your GPU and a speech model (~1.6 GB) into %USERPROFILE%\\.babelscribe.",
        "babelscribe devices   lists the GPUs whisper.cpp can use.",
        "babelscribe --help    for languages, formats and accurate mode."
    ],
    "depends": "python",
    "url": "https://files.pythonhosted.org/packages/4f/c9/9320d50c6bc123baf0b96bd76749050598e32c13018eb2267fec5077a3e6/babelscribe-0.4.0-py3-none-any.whl",
    "hash": "01fcdd2a1d6303153117f82ed2ae32097d34619549d0a568cc81c15bb4c7aaff",
    "installer": {
        "script": [
            "Push-Location \"$dir\"",
            "python -m venv babelscribe",
            ".\\babelscribe\\Scripts\\activate",
            "try {",
            "    python -m pip install --no-warn-script-location \"$fname\"",
            "}",
            "finally {",
            "    Remove-Item \"$fname\"",
            "    deactivate",
            "    Pop-Location",
            "}"
        ]
    },
    "bin": [
        "babelscribe\\Scripts\\babelscribe.exe",
        "babelscribe\\Scripts\\babelscribe-mcp.exe"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://files.pythonhosted.org/packages/py3/b/babelscribe/babelscribe-$version-py3-none-any.whl"
    }
}