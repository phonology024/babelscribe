{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "babelscribe",
  "version": "0.1.0",
  "identifier": "io.github.phonology024.babelscribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "babelscribe",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "babelscribe",
    "copyright": "MIT licence",
    "license": "MIT",
    "shortDescription": "Subtitles from video and audio, on this computer",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/babelscribe-engine"],
    "resources": {
      "engine/_internal/": "_internal/",
      "../../LICENSE": "licenses/LICENSE.txt",
      "../../packaging/standalone/THIRD-PARTY.txt": "licenses/THIRD-PARTY-engine.txt",
      "../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-app.md",
      "../src/assets/fonts/OFL.txt": "licenses/Poppins-OFL.txt"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
